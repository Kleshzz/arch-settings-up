{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "custom/prev",
        "custom/media",
        "custom/next"
    ],

    "modules-right": [
        "pulseaudio",
        "memory",
        "clock",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "custom/prev": {
        "format": "{}",
        "exec": "playerctl status 2>/dev/null | grep -q 'Playing\\|Paused' && echo '󰒮' || echo ''",
        "interval": 2,
        "on-click": "playerctl previous",
        "tooltip": false
    },

    "custom/next": {
        "format": "{}",
        "exec": "playerctl status 2>/dev/null | grep -q 'Playing\\|Paused' && echo '󰒭' || echo ''",
        "interval": 2,
        "on-click": "playerctl next",
        "tooltip": false
    },

    "custom/media": {
        "format": "{text}",
        "return-type": "json",
        "max-length": 45,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} — {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F 2>/dev/null",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "escape": true
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "bash ~/.config/waybar/power-menu.sh",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {used:0.1f}G",
        "tooltip": false,
        "interval": 5
    },

    "clock": {
        "format": "{:%H:%M  %d.%m.%Y}",
        "tooltip": false,
        "interval": 1
    }
}